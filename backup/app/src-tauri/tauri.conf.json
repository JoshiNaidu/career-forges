{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerForges",
  "version": "0.1.7",
  "identifier": "com.careerforges.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CareerForges",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "AI-powered career growth platform",
    "longDescription": "CareerForges helps developers track career growth, projects, learning progress, and professional goals through a modern desktop experience.",
    "category": "Productivity",
    "copyright": "© 2026 CareerForges",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "allowDowngrades": false
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMEZFMkU2M0JGOTJCOEYKUldTUEsvazc1dUlQU3lTZ1VlWm9aY2dnbTIvYVFuSnRTRTJ2eXdrT1owendpbzEvOWFKMUorWXEK",
      "endpoints": [
        "https://github.com/JoshiNaidu/career-forges/releases/latest/download/latest.json"
      ]
    }
  }
}
